  <template id="tmpl-wingmate">
    <div class="modal-head">
      <span class="modal-cat mono">product &amp; ux</span>
      <h2>Wingmate — Seatmate Matching App</h2>
      <span class="modal-tag mono">ux/ui · ios · end-to-end · first project</span>
    </div>
    <div class="case-study">
      <div class="case-hero">
        <img class="case-logo" src="images/wingmate/logo.png" alt="Wingmate logo">
        <p class="case-tagline">Your perfect seatmate, sorted.</p>
      </div>
      <p class="work-desc">Wingmate matches airline passengers with a compatible seatmate on the same flight. Instead of leaving who you sit next to entirely up to chance, people set a "Flight Mode" — Quiet, Social, Explorer, Business, or Romantic — answer a short personality and preference quiz, and get matched with someone on their flight who's looking for the same kind of company. Matches can chat before takeoff, and the whole loop is held together by push notifications and a trip dashboard. Built end-to-end: onboarding, sign-in, the quiz, mode selection (mobile and a desktop companion view), matching, in-app chat, and notifications.</p>

      <div class="case-stage">
        <div class="case-stage-label mono">01 · onboarding &amp; sign-in</div>
        <div class="phone-row">
          <figure class="phone-frame"><img src="images/wingmate/Landpage.png" alt="Onboarding screen: You're not like everyone else." loading="lazy"></figure>
          <figure class="phone-frame"><img src="images/wingmate/Landpage_2.png" alt="Onboarding screen: Where you sit matters." loading="lazy"></figure>
          <figure class="phone-frame"><img src="images/wingmate/Sign_In.png" alt="Sign in screen with Apple, Google, and phone number options" loading="lazy"></figure>
          <figure class="phone-frame"><img src="images/wingmate/Signing_In.png" alt="Sign in loading state" loading="lazy"></figure>
        </div>
      </div>

      <div class="case-stage">
        <div class="case-stage-label mono">02 · the quiz</div>
        <div class="phone-row">
          <figure class="phone-frame"><img src="images/wingmate/social_setting.png" alt="Quiz question: social setting preference" loading="lazy"></figure>
          <figure class="phone-frame"><img src="images/wingmate/in_fligth_vibe.png" alt="Quiz question: how you spend time on a plane" loading="lazy"></figure>
          <figure class="phone-frame"><img src="images/wingmate/interests.png" alt="Quiz screen: pick your interests" loading="lazy"></figure>
          <figure class="phone-frame"><img src="images/wingmate/pick-1.png" alt="Quiz question: pick the option that feels most like you" loading="lazy"></figure>
          <figure class="phone-frame"><img src="images/wingmate/hopes-1.png" alt="Quiz question: what are you hoping for on this flight" loading="lazy"></figure>
        </div>
      </div>

      <div class="case-stage">
        <div class="case-stage-label mono">03 · flight mode</div>
        <div class="phone-row">
          <figure class="phone-frame"><img src="images/wingmate/mode2.png" alt="Flight Mode selection screen, mobile" loading="lazy"></figure>
        </div>
        <figure class="desktop-frame"><img src="images/wingmate/Wingmate_web_workflow-1.png" alt="Desktop companion view: seat map and Flight Mode selection" loading="lazy"></figure>
      </div>

      <div class="case-stage">
        <div class="case-stage-label mono">04 · matches &amp; conversation</div>
        <div class="phone-row">
          <figure class="phone-frame"><img src="images/wingmate/MATCHES.png" alt="Your Matches screen" loading="lazy"></figure>
          <figure class="phone-frame"><img src="images/wingmate/in_conv.png" alt="In-app conversation with a match" loading="lazy"></figure>
        </div>
      </div>

      <div class="case-stage">
        <div class="case-stage-label mono">05 · notifications &amp; dashboard</div>
        <div class="phone-row">
          <figure class="phone-frame"><img src="images/wingmate/iOS_15_Push_Notifications_2.png" alt="Push notification: new flight added" loading="lazy"></figure>
          <figure class="phone-frame"><img src="images/wingmate/iOS_15_Push_Notifications_3.png" alt="Push notification: match found" loading="lazy"></figure>
          <figure class="phone-frame"><img src="images/wingmate/iOS_15_Push_Notifications.png" alt="Push notification: opted into a flight" loading="lazy"></figure>
          <figure class="phone-frame"><img src="images/wingmate/Landpage_Onboarding.png" alt="Home dashboard, empty state" loading="lazy"></figure>
          <figure class="phone-frame"><img src="images/wingmate/ejfje.png" alt="Home dashboard with trips and match status" loading="lazy"></figure>
        </div>
      </div>
    </div>
  </template>

  <template id="tmpl-labyrinth">
    <div class="modal-head">
      <span class="modal-cat mono">film &amp; thesis</span>
      <h2>Labyrinth of Broken Dreams</h2>
      <span class="modal-tag mono">2022 — rhino / 3df zephyr</span>
    </div>
    <div class="scan-frame">
      <span class="corner tl"></span><span class="corner tr"></span><span class="corner bl"></span><span class="corner br"></span>
      <div class="scan-label mono">SCAN_01 · 3D SCANNING.MP4</div>
      <div class="video-embed">
        <iframe src="https://player.vimeo.com/video/782162719?title=0&amp;byline=0&amp;portrait=0&amp;badge=0&amp;autopause=0&amp;player_id=0&amp;app_id=58479" frameborder="0" allow="autoplay; fullscreen; picture-in-picture; clipboard-write; encrypted-media; web-share" referrerpolicy="strict-origin-when-cross-origin" title="3d scanning.mp4" loading="lazy"></iframe>
      </div>
    </div>
    <p class="work-desc">In New York, many people struggle to find a place to call home — feeling as though they've become lost in an endless maze. Every time the ideal place seems found, something goes wrong. This project sits inside that feeling: never quite closer to the door out, but resolved to keep looking.</p>
  </template>

  <template id="tmpl-greenray">
    <div class="modal-head">
      <span class="modal-cat mono">film &amp; thesis</span>
      <h2>The Green Ray</h2>
      <span class="modal-tag mono">vimeo / 782178049</span>
    </div>
    <div class="scan-frame">
      <span class="corner tl"></span><span class="corner tr"></span><span class="corner bl"></span><span class="corner br"></span>
      <div class="scan-label mono">SCAN_02 · THE GREEN RAY</div>
      <div class="video-embed">
        <iframe src="https://player.vimeo.com/video/782178049?title=0&amp;byline=0&amp;portrait=0&amp;badge=0" frameborder="0" allow="autoplay; fullscreen; picture-in-picture" referrerpolicy="strict-origin-when-cross-origin" title="The Green Ray" loading="lazy"></iframe>
      </div>
    </div>
    <p class="work-desc">What is a human connection — how hard or easy is it to make, and how much does it affect us? This project was a place to explore that question, and to find connection with others, let alone with myself.</p>
  </template>

