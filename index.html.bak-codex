          <li><span class="dot"></span>Python</li>
          <li><span class="dot"></span>JavaScript / React / Node</li>
          <li><span class="dot"></span>C#</li>
          <li><span class="dot"></span>Processing / p5.js</li>
        </ul>
      </div>
      <div class="stack-col">
        <div class="stack-cat mono">design &amp; generative</div>
        <ul>
          <li class="core"><span class="dot core"></span>Figma</li>
          <li class="core"><span class="dot core"></span>ComfyUI</li>
          <li><span class="dot"></span>Adobe CC</li>
        </ul>
      </div>
    </div>
  </section>

  <!-- FOOTER -->
  <footer>
    <div class="footer-cta">let's <a href="mailto:hello@vasilikihadzikosta.com">connect</a></div>
    <div class="footer-bottom">
      <div>© 2026 vasiliki hadzikosta. all rights reserved.</div>
      <div class="socials">
        <a href="#">linkedin</a>
        <a href="#">instagram</a>
        <a href="#">pinterest</a>
      </div>
    </div>
  </footer>

<script>
  // ---------- AMBIENT BACKGROUND: drifting scan dust ----------
  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const bgCanvas = document.getElementById('bgParticles');
  const bgCtx = bgCanvas.getContext('2d');
  let bgW, bgH, bgDust = [];
  let mouseX = 0, mouseY = 0, parX = 0, parY = 0;

  function sizeBg(){
    bgW = bgCanvas.width = window.innerWidth;
    bgH = bgCanvas.height = window.innerHeight;
  }
  function seedDust(){
    const count = window.innerWidth < 720 ? 36 : 70;
    bgDust = Array.from({length: count}, () => ({
      x: Math.random() * bgW,
      y: Math.random() * bgH,
      r: Math.random() * 1.3 + 0.3,
      vy: Math.random() * 0.18 + 0.04,
      vx: (Math.random() - 0.5) * 0.06,
      depth: Math.random() * 0.6 + 0.4,
      hue: Math.random() > 0.82 ? 'accent' : 'ash',
      alpha: Math.random() * 0.35 + 0.12
    }));
  }
  sizeBg();
  seedDust();
  window.addEventListener('resize', () => { sizeBg(); });

  window.addEventListener('mousemove', (e) => {
    mouseX = (e.clientX / window.innerWidth - 0.5);
    mouseY = (e.clientY / window.innerHeight - 0.5);
  });

  function drawBg(){
    bgCtx.clearRect(0, 0, bgW, bgH);
    parX += (mouseX - parX) * 0.04;
    parY += (mouseY - parY) * 0.04;

    for(const d of bgDust){
      d.y -= d.vy;
      d.x += d.vx;
      if(d.y < -4){ d.y = bgH + 4; d.x = Math.random() * bgW; }
      if(d.x < -4) d.x = bgW + 4;
      if(d.x > bgW + 4) d.x = -4;

      const ox = parX * 22 * d.depth;
      const oy = parY * 14 * d.depth;
      bgCtx.beginPath();
      bgCtx.arc(d.x + ox, d.y + oy, d.r, 0, Math.PI * 2);
      bgCtx.fillStyle = d.hue === 'accent'
        ? `rgba(255,45,85,${d.alpha})`
        : `rgba(239,234,226,${d.alpha * 0.5})`;
      bgCtx.fill();
    }
  }

  if(reducedMotion){
    drawBg(); // single static frame, no loop
  } else {
    (function bgLoop(){
      drawBg();
      requestAnimationFrame(bgLoop);
    })();
  }

  // ---------- LOADER: point-cloud reconstruction of name ----------
  const canvas = document.getElementById('cloudCanvas');
  const ctx = canvas.getContext('2d');
  const W = canvas.width, H = canvas.height;

  // build target points by rendering text to an offscreen canvas and sampling pixels
  const off = document.createElement('canvas');
  off.width = W; off.height = H;
  const octx = off.getContext('2d');
  octx.fillStyle = '#fff';
  octx.font = '700 64px Big Shoulders Display, sans-serif';
  octx.textAlign = 'center';
  octx.textBaseline = 'middle';
  octx.fillText('VH', W/2, H/2);

  const imgData = octx.getImageData(0,0,W,H).data;
  const targets = [];
  const STEP = 4;
  for(let y=0; y<H; y+=STEP){
    for(let x=0; x<W; x+=STEP){
      const alpha = imgData[(y*W+x)*4+3];
      if(alpha > 128){ targets.push({x, y}); }
    }
  }

  const particles = targets.map(t => ({
    x: Math.random()*W,
    y: Math.random()*H,
    tx: t.x,
    ty: t.y,
    size: Math.random()*1.6 + 0.6
  }));

  let progress = 0;
  const duration = 1600; // ms
  let startTime = null;

  function drawFrame(p){
    ctx.clearRect(0,0,W,H);
    ctx.fillStyle = '#FF2D55';
    for(const pt of particles){
      const cx = pt.x + (pt.tx - pt.x) * p;
      const cy = pt.y + (pt.ty - pt.y) * p;
      ctx.beginPath();
      ctx.arc(cx, cy, pt.size, 0, Math.PI*2);
      ctx.fill();
    }
  }

  function tick(now){
    if(!startTime) startTime = now;
    const elapsed = now - startTime;
    progress = Math.min(elapsed / duration, 1);
    const eased = 1 - Math.pow(1-progress, 3);
    drawFrame(eased);

    const pctEl = document.getElementById('loaderPct');
    pctEl.textContent = Math.round(eased * particles.length).toLocaleString();

    if(progress < 1){
      requestAnimationFrame(tick);
    } else {
      document.getElementById('loaderLabel').textContent = particles.length.toLocaleString() + ' points — locked';
      setTimeout(() => {
        document.getElementById('loader').classList.add('hide');
      }, 350);
    }
  }
  requestAnimationFrame(tick);

  // ---------- ABOUT: particle blob behind the lede text ----------
  (function(){
    const blobCanvas = document.getElementById('aboutBlob');
    if(!blobCanvas) return;
    const bctx = blobCanvas.getContext('2d');
    const BW = blobCanvas.width, BH = blobCanvas.height;
    const cx = BW / 2, cy = BH / 2;

    // irregular radius-per-angle, built from a few summed sine waves (cheap organic noise)
    const lobes = [
      { amp: 26, freq: 3, phase: Math.random() * Math.PI * 2 },
      { amp: 16, freq: 5, phase: Math.random() * Math.PI * 2 },
      { amp: 10, freq: 7, phase: Math.random() * Math.PI * 2 }
    ];
    function blobRadius(angle, base){
      let r = base;
      for(const l of lobes) r += l.amp * Math.sin(l.freq * angle + l.phase);
      return r;
    }

    const baseR = BW * 0.32;
    const blobPts = [];
    const N = reducedMotion ? 220 : 320;
    let tries = 0;
    while(blobPts.length < N && tries < N * 12){
      tries++;
      const a = Math.random() * Math.PI * 2;
      const maxR = blobRadius(a, baseR);
      const r = Math.sqrt(Math.random()) * maxR; // bias toward filling, not just edge
      blobPts.push({
        x: cx + Math.cos(a) * r,
        y: cy + Math.sin(a) * r,
        size: Math.random() * 1.8 + 0.5,
        accent: Math.random() > 0.78,
        alpha: Math.random() * 0.5 + 0.25,
        driftA: Math.random() * Math.PI * 2,
        driftSpeed: Math.random() * 0.0006 + 0.0002
      });
    }

    function drawBlob(t){
      bctx.clearRect(0, 0, BW, BH);
      for(const p of blobPts){
        const jx = Math.cos(p.driftA + t * p.driftSpeed * 1000) * 2;
        const jy = Math.sin(p.driftA + t * p.driftSpeed * 1000) * 2;
        bctx.beginPath();
        bctx.arc(p.x + jx, p.y + jy, p.size, 0, Math.PI * 2);
        bctx.fillStyle = p.accent
          ? `rgba(255,45,85,${p.alpha})`
          : `rgba(239,234,226,${p.alpha * 0.6})`;
        bctx.fill();
      }
    }

    if(reducedMotion){
      drawBlob(0);
    } else {
      (function blobLoop(t){
        drawBlob(t || 0);
        requestAnimationFrame(blobLoop);
      })();
    }
  })();

  // ---------- WORLD CLOCK STRIP ----------
  function formatTime(offsetHours){
    const now = new Date();
    const utc = now.getTime() + (now.getTimezoneOffset()*60000);
    const target = new Date(utc + (3600000*offsetHours));
    let h = target.getHours().toString().padStart(2,'0');
    let m = target.getMinutes().toString().padStart(2,'0');
    return h+':'+m;
  }
  function updateClocks(){
    document.getElementById('t-par').textContent = formatTime(2);    // CEST approx
    document.getElementById('t-angkor').textContent = formatTime(7); // Cambodia
    document.getElementById('t-mosul').textContent = formatTime(3);  // Iraq
    document.getElementById('t-la').textContent = formatTime(-7);    // PDT approx
  }
  updateClocks();
  setInterval(updateClocks, 1000*30);

  // ---------- PROJECT MODAL ----------
  const projectModal = document.getElementById('projectModal');
  const modalContent = document.getElementById('modalContent');
  const modalClose = document.getElementById('modalClose');

  function openModal(id){
    const tmpl = document.getElementById('tmpl-' + id);
    if(!tmpl) return;
    modalContent.innerHTML = '';
    modalContent.appendChild(tmpl.content.cloneNode(true));
    projectModal.classList.add('open');
    document.body.classList.add('modal-open');
    modalClose.focus();
  }
  function closeModal(){
    projectModal.classList.remove('open');
    document.body.classList.remove('modal-open');
    modalContent.innerHTML = ''; // clears embedded video iframes so they stop playing
  }

  document.querySelectorAll('.project-card').forEach(card => {
    card.addEventListener('click', () => openModal(card.dataset.modal));
  });
  modalClose.addEventListener('click', closeModal);
  projectModal.addEventListener('click', (e) => { if(e.target === projectModal) closeModal(); });
  document.addEventListener('keydown', (e) => { if(e.key === 'Escape') closeModal(); });

  // ---------- WORK FILTER PILLS ----------
  const filterRow = document.getElementById('filterRow');
  const projectGrid = document.getElementById('projectGrid');
  filterRow.querySelectorAll('.filter-pill').forEach(btn => {
    btn.addEventListener('click', () => {
      filterRow.querySelectorAll('.filter-pill').forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      const f = btn.dataset.filter;
      projectGrid.querySelectorAll('.project-card').forEach(card => {
        card.style.display = (f === 'all' || card.dataset.category === f) ? '' : 'none';
      });
    });
  });

  // ---------- THE WALL: posters / fun stuff ----------
  // To add a piece: drop a new object in this array.
  //   type     -> "image" or "video"
  //   src      -> image path, or video path for type "video" (e.g. "images/wall/clip.mp4")
  //   poster   -> (video only, optional) thumbnail image shown before play
  //   caption  -> short line, e.g. "Birthday poster — for Mira, 2026"
  //   tall     -> (image only, optional) set true for long/scrolling pieces — shows a top-cropped
  //               thumbnail and opens the full image in a lightbox instead of just cropping it
  // Leave the array entry out (or set src to null) to keep an empty pinned slot instead.
  const wallPieces = [
    { type: "image", src: "images/wall/khaite-white-edit.jpg", caption: "Khaite — \u201cThe White Edit\u201d newsletter edit", tall: true },
    // { src: "images/poster-01.jpg", caption: "Midnight Star — birthday scavenger hunt poster" },
     { type: "video", src: "images/wall/neutral-lorrai-knit-silk-cardigan.mp4", poster: "images/wall/neutral-lorrai-knit-silk-cardigan.jpg", caption: "Neutral Lorrai Knit Silk Cardigan"},
  ];

  const MIN_SLOTS = 6; // keeps the wall looking full even with zero pieces yet
  const wallGrid = document.getElementById('wallGrid');
  const wallCount = document.getElementById('wallCount');
  const rotations = [-3, 2, -1.5, 3, -2.5, 1.5, -1, 2.5];

  function randRot(){
    return (Math.random() * 7 - 3.5).toFixed(1);
  }

  function makePin(piece, rot){
    const el = document.createElement('div');
    el.style.setProperty('--r', rot + 'deg');
    el.setAttribute('draggable', 'true');

    if(piece && piece.src){
      el.className = 'pin' + (piece.tall ? ' tall' : '');
      if(piece.type === 'video'){
        el.classList.add('is-video');
        el.innerHTML = `
          <img class="pin-img" src="${piece.poster || piece.src}" alt="${piece.caption || 'video'}" loading="lazy">
          <span class="pin-play">▶</span>
          <div class="pin-cap mono">${piece.caption || ''}</div>
        `;
      } else {
        el.innerHTML = `
          <img class="pin-img" src="${piece.src}" alt="${piece.caption || 'poster'}" loading="lazy">
          ${piece.tall ? '<span class="pin-expand mono">view full ↗</span>' : ''}
          <div class="pin-cap mono">${piece.caption || ''}</div>
        `;
      }
      el.addEventListener('click', (e) => {
        // don't trigger lightbox mid-drag
        if(el.classList.contains('dragging')) return;
        openWallLightbox(piece);
      });
    } else {
      el.className = 'pin empty';
      el.innerHTML = `<div class="pin-plus">+ send me<br>a poster</div>`;
    }
    return el;
  }

  const total = Math.max(wallPieces.length, MIN_SLOTS);
  for(let i = 0; i < total; i++){
    wallGrid.appendChild(makePin(wallPieces[i], rotations[i % rotations.length]));
  }
  wallCount.textContent = (wallPieces.length || '0') + ' PIECES';

  // ---- lightbox for full-size view (images + video) ----
  const wallLightbox = document.getElementById('wallLightbox');
  const wallLightboxContent = document.getElementById('wallLightboxContent');
  const wallLightboxClose = document.getElementById('wallLightboxClose');

  function openWallLightbox(piece){
    wallLightboxContent.innerHTML = '';
    if(piece.type === 'video'){
      const v = document.createElement('video');
      v.src = piece.src;
      v.controls = true;
      v.autoplay = true;
      v.playsInline = true;
      wallLightboxContent.appendChild(v);
    } else {
      const img = document.createElement('img');
      img.src = piece.src;
      img.alt = piece.caption || '';
      wallLightboxContent.appendChild(img);
    }
    if(piece.caption){
      const cap = document.createElement('div');
      cap.className = 'lightbox-cap mono';
      cap.textContent = piece.caption;
      wallLightboxContent.appendChild(cap);
    }
    wallLightbox.classList.add('open');
    document.body.classList.add('modal-open');
  }
  function closeWallLightbox(){
    wallLightbox.classList.remove('open');
    document.body.classList.remove('modal-open');
    wallLightboxContent.innerHTML = ''; // stops any playing video
  }
  wallLightboxClose.addEventListener('click', closeWallLightbox);
  wallLightbox.addEventListener('click', (e) => { if(e.target === wallLightbox) closeWallLightbox(); });
  document.addEventListener('keydown', (e) => { if(e.key === 'Escape') closeWallLightbox(); });

  // ---- drag to reorder ----
  let draggedEl = null;

  wallGrid.addEventListener('dragstart', (e) => {
    const pin = e.target.closest('.pin');
    if(!pin) return;
    draggedEl = pin;
    pin.classList.add('dragging');
    e.dataTransfer.effectAllowed = 'move';
  });

  wallGrid.addEventListener('dragend', (e) => {
    const pin = e.target.closest('.pin');
    if(pin) pin.classList.remove('dragging');
    wallGrid.querySelectorAll('.pin.drag-over').forEach(p => p.classList.remove('drag-over'));
    draggedEl = null;
  });

  wallGrid.addEventListener('dragover', (e) => {
    e.preventDefault();
    const target = e.target.closest('.pin');
    if(!target || target === draggedEl) return;
    wallGrid.querySelectorAll('.pin.drag-over').forEach(p => p.classList.remove('drag-over'));
    target.classList.add('drag-over');
  });

  wallGrid.addEventListener('drop', (e) => {
    e.preventDefault();
    const target = e.target.closest('.pin');
    if(!target || !draggedEl || target === draggedEl) return;
    target.classList.remove('drag-over');

    const children = Array.from(wallGrid.children);
    const draggedIdx = children.indexOf(draggedEl);
    const targetIdx = children.indexOf(target);

    if(draggedIdx < targetIdx){
      target.after(draggedEl);
    } else {
      target.before(draggedEl);
    }
  });

  // ---- shuffle button ----
  const shuffleBtn = document.getElementById('shuffleBtn');
  shuffleBtn.addEventListener('click', () => {
    const pins = Array.from(wallGrid.children);
    pins.forEach(p => p.classList.add('shuffle-out'));

    setTimeout(() => {
      // Fisher–Yates shuffle, then reassign fresh tilts
      for(let i = pins.length - 1; i > 0; i--){
        const j = Math.floor(Math.random() * (i + 1));
        [pins[i], pins[j]] = [pins[j], pins[i]];
      }
      pins.forEach((p, i) => {
        p.style.setProperty('--r', randRot() + 'deg');
        wallGrid.appendChild(p);
        p.classList.remove('shuffle-out');
        p.classList.add('shuffle-in');
        p.style.transitionDelay = (i * 35) + 'ms';
        requestAnimationFrame(() => {
          p.classList.remove('shuffle-in');
        });
      });
      setTimeout(() => pins.forEach(p => { p.style.transitionDelay = ''; }), 600);
    }, 280);
  });
</script>

</body>
</html>
