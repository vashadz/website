<!doctype html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Vasiliki Hadzikosta — Creative Technologist</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Big+Shoulders+Display:wght@400;600;800;900&family=Spectral:ital,wght@0,400;0,500;1,400;1,500&family=IBM+Plex+Mono:wght@400;500&display=swap" rel="stylesheet">
<style>
  :root{
    --bg:#0B0B0C;
    --fg:#EFEAE2;
    --accent:#FF2D55;
    --ash:#8C8880;
    --line:#232323;
  }
  *{box-sizing:border-box; margin:0; padding:0;}
  html{scroll-behavior:smooth;}
  body{
    background:var(--bg);
    color:var(--fg);
    font-family:'Spectral', serif;
    overflow-x:hidden;
    cursor:default;
  }
  ::selection{ background:var(--accent); color:var(--bg); }

  #bgParticles{
    position:fixed; top:0; left:0; width:100vw; height:100vh;
    z-index:-1; pointer-events:none;
  }

  .mono{ font-family:'IBM Plex Mono', monospace; font-weight:500; letter-spacing:0.04em; }
  .display{ font-family:'Big Shoulders Display', sans-serif; text-transform:uppercase; }

  a{ color:inherit; text-decoration:none; }

  /* ---------------- LOADER ---------------- */
  #loader{
    position:fixed; inset:0; z-index:999;
    background:var(--bg);
    display:flex; flex-direction:column; align-items:center; justify-content:center;
    transition:opacity 0.9s ease, visibility 0.9s ease;
  }
  #loader.hide{ opacity:0; visibility:hidden; pointer-events:none; }
  #cloudCanvas{ width:280px; height:280px; }
  #loaderLabel{
    margin-top:18px; font-size:11px; color:var(--ash);
    letter-spacing:0.25em; text-transform:uppercase;
  }
  #loaderPct{ color:var(--accent); }

  /* ---------------- NAV ---------------- */
  nav{
    position:fixed; top:0; left:0; right:0; z-index:100;
    display:flex; justify-content:space-between; align-items:center;
    padding:22px 5vw;
    font-size:11px;
    letter-spacing:0.18em;
    text-transform:uppercase;
    mix-blend-mode:difference;
  }
  nav .links{ display:flex; gap:28px; }
  nav .links a{ position:relative; padding-bottom:2px; }
  nav .links a::after{
    content:''; position:absolute; left:0; bottom:0; width:0; height:1px;
    background:var(--fg); transition:width 0.3s ease;
  }
  nav .links a:hover::after{ width:100%; }
  nav .brand{ font-family:'Big Shoulders Display', sans-serif; font-weight:700; }

  /* ---------------- HERO ---------------- */
  .hero{
    min-height:100vh;
    display:flex; flex-direction:column; justify-content:center;
    padding:0 5vw;
    position:relative;
  }
  .eyebrow{
    font-size:11px; color:var(--ash); letter-spacing:0.3em; text-transform:uppercase;
    margin-bottom:18px;
    opacity:0; transform:translateY(8px);
    animation:riseIn 0.8s ease forwards;
    animation-delay:0.2s;
  }
  h1.name{
    font-size:clamp(48px, 11vw, 168px);
    line-height:0.92;
    font-weight:900;
    letter-spacing:-0.01em;
    opacity:0; transform:translateY(14px);
    animation:riseIn 0.9s ease forwards;
    animation-delay:0.35s;
  }
  h1.name span{ display:block; }
  h1.name .accent{ color:var(--accent); }
  .role{
    margin-top:24px; max-width:560px;
    font-family:'Spectral', serif; font-style:italic;
    font-size:clamp(16px, 2.1vw, 22px);
    color:var(--fg); opacity:0.88;
    line-height:1.5;
    opacity:0; transform:translateY(10px);
    animation:riseIn 0.9s ease forwards;
    animation-delay:0.5s;
  }
  @keyframes riseIn{ to{ opacity:1; transform:translateY(0); } }

  .scrollcue{
    position:absolute; bottom:34px; left:5vw;
    font-size:10px; letter-spacing:0.25em; color:var(--ash);
    display:flex; align-items:center; gap:10px;
  }
  .scrollcue .bar{ width:1px; height:34px; background:var(--ash); position:relative; overflow:hidden; }
  .scrollcue .bar::after{
    content:''; position:absolute; top:0; left:0; width:100%; height:30%;
    background:var(--accent); animation:scrollbar 1.6s ease-in-out infinite;
  }
  @keyframes scrollbar{ 0%{top:-30%;} 100%{top:100%;} }

  /* ---------------- CLOCK STRIP ---------------- */
  .clockstrip{
    border-top:1px solid var(--line);
    border-bottom:1px solid var(--line);
    padding:14px 5vw;
    display:flex; gap:48px; flex-wrap:wrap;
    font-size:11px; letter-spacing:0.1em;
  }
  .clockstrip .item{ display:flex; gap:8px; color:var(--ash); }
  .clockstrip .item b{ color:var(--fg); font-weight:500; }
  .clockstrip .item .t{ color:var(--accent); }

  /* ---------------- SECTION SCAFFOLD ---------------- */
  section{ padding:140px 5vw; position:relative; }
  .section-head{
    display:flex; justify-content:space-between; align-items:baseline;
    margin-bottom:64px; gap:24px; flex-wrap:wrap;
    border-bottom:1px solid var(--line); padding-bottom:18px;
  }
  .section-head .num{ font-size:11px; color:var(--accent); letter-spacing:0.2em; }
  .section-head h2{
    font-family:'Big Shoulders Display', sans-serif; text-transform:uppercase;
    font-weight:700; font-size:clamp(22px, 3vw, 34px);
  }
  .section-head .count{ font-size:11px; color:var(--ash); letter-spacing:0.15em; }

  /* ---------------- WORK: FILTERS + PROJECT GRID ---------------- */
  .filter-row{
    display:flex; gap:10px; flex-wrap:wrap; margin-bottom:44px;
  }
  .filter-pill{
    background:none; border:1px solid var(--line); color:var(--ash);
    font-size:11px; letter-spacing:0.08em; text-transform:uppercase;
    padding:8px 16px; cursor:pointer;
    transition:border-color 0.25s ease, color 0.25s ease;
  }
  .filter-pill:hover{ color:var(--fg); border-color:var(--ash); }
  .filter-pill.active{ border-color:var(--accent); color:var(--accent); }

  .project-grid{
    display:grid;
    grid-template-columns:repeat(auto-fill, minmax(260px, 1fr));
    gap:28px;
  }
  .project-card{
    cursor:pointer; border:1px solid var(--line); background:#101011;
    transition:transform 0.3s ease, border-color 0.3s ease, box-shadow 0.3s ease;
  }
  .project-card:hover{
    transform:translateY(-5px); border-color:var(--accent);
    box-shadow:0 18px 32px rgba(0,0,0,0.4);
  }
  .card-thumb{
    position:relative; aspect-ratio:4/3; overflow:hidden; background:#0C0C0D;
  }
  .card-thumb img{
    width:100%; height:100%; object-fit:cover; display:block;
    transition:transform 0.45s ease;
  }
  .project-card:hover .card-thumb img{ transform:scale(1.06); }
  .placeholder-thumb{
    display:flex; align-items:center; justify-content:center;
    background:repeating-linear-gradient(135deg, #141415 0 14px, #18181a 14px 28px);
  }
  .thumb-icon{ font-size:30px; color:var(--ash); opacity:0.55; }
  .card-meta{ padding:18px 18px 22px; }
  .card-idx{ display:block; color:var(--accent); margin-bottom:8px; font-size:11px; }
  .card-title{
    font-family:'Big Shoulders Display', sans-serif; text-transform:uppercase;
    font-weight:700; font-size:17px; line-height:1.25; margin-bottom:10px;
  }
  .card-tag{ font-size:11px; color:var(--ash); letter-spacing:0.06em; }

  /* ---------------- PROJECT MODAL ---------------- */
  .modal-overlay{
    position:fixed; inset:0; z-index:200;
    background:rgba(5,5,6,0.86);
    backdrop-filter:blur(6px);
    display:flex; align-items:flex-start; justify-content:center;
    padding:70px 5vw 40px;
    opacity:0; visibility:hidden;
    transition:opacity 0.3s ease, visibility 0.3s ease;
    overflow-y:auto;
  }
  .modal-overlay.open{ opacity:1; visibility:visible; }
  .modal-panel{
    position:relative; max-width:920px; width:100%;
    background:var(--bg); border:1px solid var(--line);
    padding:52px clamp(20px,4vw,56px) 64px;
    margin-bottom:60px;
  }
  .modal-close{
    position:absolute; top:16px; right:16px; width:38px; height:38px;
    border:1px solid var(--line); background:none; color:var(--fg);
    font-size:20px; line-height:1; cursor:pointer;
    transition:border-color 0.25s ease, color 0.25s ease;
  }
  .modal-close:hover{ border-color:var(--accent); color:var(--accent); }
  .modal-head{ margin-bottom:26px; }
  .modal-cat{
    color:var(--accent); font-size:11px; letter-spacing:0.15em; text-transform:uppercase;
  }
  .modal-head h2{
    font-family:'Big Shoulders Display', sans-serif; text-transform:uppercase;
    font-weight:800; font-size:clamp(26px, 4vw, 42px); margin:10px 0; line-height:1.05;
  }
  .modal-tag{ color:var(--ash); font-size:11px; letter-spacing:0.1em; }
  .modal-pending{
    color:var(--ash); margin-top:22px; font-size:11px; letter-spacing:0.04em;
  }
  body.modal-open{ overflow:hidden; }

  .scan-frame{
    position:relative;
    border:1px solid var(--line);
    padding:18px;
    background:#0E0E0F;
  }
  .scan-frame .corner{
    position:absolute; width:16px; height:16px;
    border:2px solid var(--accent);
  }
  .scan-frame .corner.tl{ top:-1px; left:-1px; border-right:none; border-bottom:none; }
  .scan-frame .corner.tr{ top:-1px; right:-1px; border-left:none; border-bottom:none; }
  .scan-frame .corner.bl{ bottom:-1px; left:-1px; border-right:none; border-top:none; }
  .scan-frame .corner.br{ bottom:-1px; right:-1px; border-left:none; border-top:none; }
  .scan-label{
    font-size:10px; letter-spacing:0.2em; color:var(--accent);
    margin-bottom:12px;
  }
  .video-embed{ position:relative; width:100%; padding:56.25% 0 0 0; background:#000; }
  .video-embed iframe{ position:absolute; top:0; left:0; width:100%; height:100%; border:0; }
  .work-desc{
    max-width:720px; margin-top:22px;
    font-size:15px; line-height:1.7; color:var(--fg); opacity:0.85;
  }

  /* ---------------- CASE STUDY (Wingmate) ---------------- */
  .case-study{ padding-top:4px; }
  .case-hero{
    display:flex; align-items:center; gap:22px; flex-wrap:wrap;
    margin-bottom:6px;
  }
  .case-logo{ height:56px; width:auto; }
  .case-tagline{
    font-family:'Spectral', serif; font-style:italic; font-size:18px;
    color:var(--ash);
  }
  .case-stage{ margin-top:44px; }
  .case-stage-label{
    font-size:11px; letter-spacing:0.15em; color:var(--accent);
    text-transform:uppercase; border-bottom:1px solid var(--line);
    padding-bottom:10px; margin-bottom:18px;
  }
  .phone-row{
    display:flex; gap:18px; overflow-x:auto; padding-bottom:10px;
    scrollbar-width:thin; scrollbar-color:var(--line) transparent;
  }
  .phone-row::-webkit-scrollbar{ height:5px; }
  .phone-row::-webkit-scrollbar-thumb{ background:var(--line); }
  .phone-frame{
    flex:none; width:150px;
    border:5px solid #1A1A1B; border-radius:22px;
    overflow:hidden; background:#000; margin:0;
    box-shadow:0 14px 28px rgba(0,0,0,0.45);
  }
  .phone-frame img{ width:100%; display:block; }
  .desktop-frame{
    margin-top:16px;
    border:1px solid var(--line); border-radius:6px; overflow:hidden;
    box-shadow:0 14px 28px rgba(0,0,0,0.4);
  }
  .desktop-frame img{ width:100%; display:block; }

  /* ---------------- ABOUT ---------------- */
  .about-grid{
    display:grid; grid-template-columns:1fr 1fr; gap:60px;
  }
  .about-grid .lede{
    font-size:clamp(20px, 2.6vw, 30px);
    line-height:1.4;
  }
  .about-grid .lede em{ color:var(--accent); font-style:italic; }
  .about-grid .lede{
    position:relative;
    overflow:visible;
  }
  .lede-blob{
    position:absolute;
    top:-70px; left:-90px;
    width:480px; height:480px;
    z-index:0;
    pointer-events:none;
    opacity:0.55;
  }
  .lede-text{ position:relative; z-index:1; }
  .about-meta{ font-family:'IBM Plex Mono', monospace; font-size:12px; color:var(--ash); line-height:2; }
  .about-meta .row{ display:flex; justify-content:space-between; border-bottom:1px solid var(--line); padding:10px 0; gap:16px; }
  .about-meta .row b{ color:var(--fg); font-weight:500; text-align:right; }
  .stack-more{ color:var(--accent); }
  .stack-more:hover{ text-decoration:underline; }

  /* ---------------- LAB / PLAYGROUND ---------------- */
  .lab-grid{
    display:grid; grid-template-columns:repeat(auto-fit, minmax(220px,1fr));
    gap:1px; background:var(--line);
  }
  .lab-card{
    background:var(--bg); padding:34px 26px; min-height:180px;
    display:flex; flex-direction:column; justify-content:space-between;
    transition:background 0.3s ease;
  }
  .lab-card:hover{ background:#121214; }
  .lab-card .lab-title{ font-family:'Big Shoulders Display',sans-serif; text-transform:uppercase; font-weight:700; font-size:15px; }
  .lab-card .lab-desc{ font-size:12px; color:var(--ash); font-family:'IBM Plex Mono',monospace; margin-top:14px; line-height:1.6; }
  .lab-card .lab-go{
    display:block; margin-top:10px; color:var(--accent); opacity:0;
    transform:translateY(-4px); transition:opacity 0.25s ease, transform 0.25s ease;
  }
  .lab-card:hover .lab-go{ opacity:1; transform:translateY(0); }

  /* ---------------- THE WALL (posters / for fun) ---------------- */
  .wall-controls{
    display:flex; align-items:center; gap:20px;
    font-size:11px; color:var(--ash); letter-spacing:0.1em;
  }
  .wall-hint{ display:none; }
  @media (min-width:720px){ .wall-hint{ display:inline; } }
  .shuffle-btn{
    background:none; border:1px solid var(--line); color:var(--fg);
    font-size:11px; letter-spacing:0.1em; text-transform:uppercase;
    padding:7px 14px; cursor:pointer;
    transition:border-color 0.25s ease, color 0.25s ease, transform 0.25s ease;
  }
  .shuffle-btn:hover{ border-color:var(--accent); color:var(--accent); }
  .shuffle-btn:active{ transform:scale(0.94); }
  .shuffle-btn.spin svg, .shuffle-btn.spin{ animation:none; }

  .wall-grid{
    display:grid;
    grid-template-columns:repeat(auto-fill, minmax(190px, 1fr));
    gap:34px 28px;
  }
  .pin{
    position:relative;
    background:#161617;
    border:1px solid var(--line);
    padding:14px 14px 18px;
    transform:rotate(var(--r, 0deg));
    transition:transform 0.3s ease, box-shadow 0.3s ease, border-color 0.3s ease, opacity 0.3s ease;
    box-shadow:0 10px 24px rgba(0,0,0,0.35);
    cursor:grab;
  }
  .pin:hover{
    transform:rotate(0deg) scale(1.04) translateY(-4px);
    box-shadow:0 18px 34px rgba(0,0,0,0.5);
    border-color:var(--accent);
    z-index:5;
  }
  .pin::before{
    content:'';
    position:absolute; top:-7px; left:50%; transform:translateX(-50%) rotate(-3deg);
    width:26px; height:14px;
    background:var(--accent);
    opacity:0.9;
    clip-path:polygon(0 0, 100% 0, 92% 100%, 8% 100%);
  }
  .pin .pin-img{
    width:100%; aspect-ratio:4/5; object-fit:cover; object-position:center; display:block;
    background:#0E0E0F;
    filter:saturate(0.96);
    pointer-events:none;
  }
  .pin.tall .pin-img{ object-position:top; }
  .pin-expand{
    position:absolute; top:18px; right:18px;
    background:rgba(0,0,0,0.65); color:var(--fg);
    font-size:10px; letter-spacing:0.08em; text-transform:uppercase;
    padding:4px 8px; opacity:0; transition:opacity 0.25s ease;
    pointer-events:none;
  }
  .pin:hover .pin-expand{ opacity:1; }
  .pin.is-video .pin-img{ filter:saturate(0.85) brightness(0.8); }
  .pin-play{
    position:absolute; top:50%; left:50%; transform:translate(-50%,-50%);
    width:42px; height:42px; border-radius:50%;
    background:rgba(0,0,0,0.55); border:1px solid var(--accent);
    color:var(--accent); display:flex; align-items:center; justify-content:center;
    font-size:13px; pointer-events:none;
  }
  .pin .pin-cap{
    margin-top:10px; font-size:11px; color:var(--ash);
    letter-spacing:0.06em; line-height:1.4;
  }
  .pin .pin-cap b{ color:var(--fg); font-weight:500; }

  .pin.empty{
    aspect-ratio:4/5; height:auto;
    display:flex; align-items:center; justify-content:center;
    border:1px dashed var(--line);
    background:transparent;
    box-shadow:none;
  }
  .pin.empty:hover{ transform:rotate(0deg); border-color:var(--ash); box-shadow:none; }
  .pin.empty .pin-plus{
    font-size:11px; color:var(--ash); letter-spacing:0.12em; text-align:center;
    font-family:'IBM Plex Mono',monospace; text-transform:uppercase; padding:0 16px;
    pointer-events:none;
  }

  /* drag + shuffle states */
  .pin.dragging{ opacity:0.25; cursor:grabbing; }
  .pin.drag-over{ border-color:var(--accent); }
  .pin.shuffle-out{ opacity:0; transform:scale(0.82) rotate(var(--r,0deg)); }
  .pin.shuffle-in{ opacity:0; transform:scale(0.82) rotate(var(--r,0deg)); }

  /* wall lightbox (reuses modal-overlay) */
  .lightbox-panel{
    max-width:680px; padding:24px; background:#0c0c0d;
  }
  .lightbox-content{ max-height:82vh; overflow-y:auto; }
  .lightbox-content img, .lightbox-content video{
    width:100%; display:block; border:1px solid var(--line);
  }
  .lightbox-cap{
    margin-top:14px; font-size:11px; color:var(--ash); letter-spacing:0.06em;
  }

  /* ---------------- STACK ---------------- */
  .section-head .count .dot{
    display:inline-block; width:6px; height:6px; border-radius:50%;
    background:var(--line); margin-right:4px; vertical-align:middle;
  }
  .section-head .count .dot.core{ background:var(--accent); }

  .stack-grid{
    display:grid;
    grid-template-columns:repeat(auto-fit, minmax(200px, 1fr));
    gap:48px;
  }
  .stack-cat{
    font-family:'Big Shoulders Display', sans-serif; text-transform:uppercase;
    font-weight:700; font-size:13px; letter-spacing:0.12em; color:var(--ash);
    border-bottom:1px solid var(--line); padding-bottom:10px; margin-bottom:16px;
  }
  .stack-col ul{ list-style:none; }
  .stack-col li{
    font-family:'IBM Plex Mono', monospace; font-size:13px; color:var(--fg);
    display:flex; align-items:center; gap:10px; padding:7px 0;
  }
  .stack-col li.core{ color:var(--fg); font-weight:500; }
  .stack-col li .dot{
    width:6px; height:6px; border-radius:50%; flex:none; background:var(--line);
  }
  .stack-col li .dot.core{ background:var(--accent); }

  /* ---------------- FOOTER ---------------- */
  footer{
    padding:120px 5vw 60px;
    border-top:1px solid var(--line);
  }
  .footer-cta{
    font-family:'Big Shoulders Display', sans-serif; text-transform:uppercase;
    font-weight:900; font-size:clamp(34px, 8vw, 96px);
    line-height:0.95;
  }
  .footer-cta a{ color:var(--accent); }
  .footer-bottom{
    display:flex; justify-content:space-between; align-items:flex-end;
    margin-top:80px; flex-wrap:wrap; gap:24px;
    font-size:11px; color:var(--ash); letter-spacing:0.1em;
  }
  .footer-bottom .socials{ display:flex; gap:22px; }
  .footer-bottom .socials a{ position:relative; }
  .footer-bottom .socials a::after{
    content:''; position:absolute; left:0; bottom:-4px; width:0; height:1px; background:var(--accent);
    transition:width 0.3s ease;
  }
  .footer-bottom .socials a:hover::after{ width:100%; }
  .footer-bottom .socials a:hover{ color:var(--fg); }

  @media (max-width:720px){
    .about-grid{ grid-template-columns:1fr; }
    .work-row{ grid-template-columns:34px 1fr; row-gap:8px; }
    .work-row .tag, .work-row .arrow{ grid-column:2; }
    nav{ font-size:10px; padding:16px 5vw; }
    nav .links{ gap:16px; }
  }

  @media (prefers-reduced-motion: reduce){
    *{ animation-duration:0.01ms !important; animation-iteration-count:1 !important; transition-duration:0.01ms !important; }
  }
</style>
</head>
<body>

  <canvas id="bgParticles"></canvas>

  <!-- LOADER -->
  <div id="loader">
    <canvas id="cloudCanvas" width="280" height="280"></canvas>
    <div id="loaderLabel">aligning points — <span id="loaderPct">0</span></div>
  </div>

  <!-- NAV -->
  <nav>
    <div class="brand mono">V.H.</div>
    <div class="links mono">
      <a href="#work">01 work</a>
      <a href="#about">02 about</a>
      <a href="#lab">03 lab</a>
      <a href="#wall">04 wall</a>
      <a href="#stack">05 stack</a>
    </div>
  </nav>

  <!-- HERO -->
  <div class="hero">
    <div class="eyebrow mono">creative technologist — currently digitizing ruins for unesco</div>
    <h1 class="name display">
      <span>Vasiliki</span>
      <span class="accent">Hadzikosta</span>
    </h1>
    <p class="role">Most of what I work on started out as a ruin. By day I help put ancient sites back together inside Unreal, point by scanned point — by night I make smaller, stranger things just because I can.</p>
    <div class="scrollcue mono"><div class="bar"></div>scroll</div>
  </div>

  <!-- CLOCK STRIP -->
  <div class="clockstrip mono" id="clockstrip">
    <div class="item">PAR <b id="t-par">--:--</b></div>
    <div class="item">ANGKOR <b id="t-angkor">--:--</b></div>
    <div class="item">MOSUL <b id="t-mosul">--:--</b></div>
    <div class="item">LA <b id="t-la">--:--</b></div>
  </div>

